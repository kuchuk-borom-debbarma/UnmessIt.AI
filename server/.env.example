# UnmessIt.AI Server Runtime Configuration
# Copy this file to .env for manual backend runs.
#
# AI provider, model, embedding, and API key settings are configured per user
# inside the app Settings screen. Do not put those values here.

# Use a long random value before sharing a beta deployment.
JWT_SECRET=change-me-before-sharing

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Disable development-only inspection/reset routes for beta deploys.
ENABLE_DEV_ROUTES=0

# Server logging.
LOG_LEVEL=INFO
