# UnmessIt.AI Server Configuration Template
# Copy this file to .env and configure your values.

# LLM Provider: 'ollama' or 'openai' (which handles OpenAI, LM Studio, OpenRouter, and other OpenAI-compatible APIs)
INGEST_MODEL_PROVIDER=ollama

# The LLM model identifier (e.g. 'llama3.2:latest', 'qwen2.5:3b', or model tags on OpenRouter)
INGEST_MODEL_NAME=llama3.2:latest

# Custom API base URL for the LLM provider.
# If left blank, defaults to the provider's standard endpoint (Ollama's local port, or OpenAI's public API).
# For LM Studio, set this to: http://localhost:1234/v1
# For OpenRouter, set this to: https://openrouter.ai/api/v1
INGEST_MODEL_BASE_URL=

# API Key (required for OpenRouter, OpenAI, etc.)
INGEST_MODEL_API_KEY=

# Ingestion configuration settings
INGEST_MODEL_TEMPERATURE=0.0
INGEST_MODEL_MAX_RETRIES=2

# Embedding Provider: 'ollama' or 'openai'
EMBEDDING_MODEL_PROVIDER=ollama

# The Embedding model identifier (e.g. 'nomic-embed-text', 'text-embedding-3-small')
EMBEDDING_MODEL_NAME=nomic-embed-text

# Custom API base URL for Embedding model
EMBEDDING_MODEL_BASE_URL=

# API Key for Embedding model
EMBEDDING_MODEL_API_KEY=

# General Server Settings
LOG_LEVEL=INFO
